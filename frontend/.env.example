# Leave NEXT_PUBLIC_API_URL unset to use the same-origin proxy (/api/v1 -> BACKEND_URL). Recommended for production.
# Locally you may point straight at the API instead: NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_CONTACT_EMAIL=raj@gmail.com

# PostHog analytics (optional). Without a token nothing is tracked and the app runs normally.
# Project token from PostHog > Settings > Project. It is public and safe in the browser.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# EU project: https://eu.i.posthog.com  |  US project: https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Where the admin "Open PostHog" links point (EU: https://eu.posthog.com, US: https://us.posthog.com)
NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com
# Optional: paste your exact project URL so admin links land in the right project,
# e.g. https://eu.posthog.com/project/12345
NEXT_PUBLIC_POSTHOG_PROJECT_URL=
