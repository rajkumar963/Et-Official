NODE_ENV=development
PORT=4000
# Production behind Vercel + Render: TRUST_PROXY=2
TRUST_PROXY=0
# Must match the exact origin your site is served from (the site redirects the apex to www,
# so www is the live origin). Used in emails and OAuth redirects.
FRONTEND_URL=https://www.etofficial.com
# Comma-separated browser origins allowed by CORS and the CSRF origin check.
# Include EVERY origin visitors can load the site from. Missing the www entry causes
# "Request origin is not allowed" on signup/login.
FRONTEND_ORIGINS=http://localhost:3000,https://www.etofficial.com,https://etofficial.com
MONGODB_URI=mongodb.net/et-trader
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
# Production (goes through the frontend proxy): https://www.etofficial.com/api/v1/auth/google/callback
# Email verification codes are sent with Resend (https://resend.com). Create an API key and paste it here.
# Without a key, development prints codes to the backend console. Production requires a key.
RESEND_API_KEY=
# Until you verify your own domain in Resend, onboarding@resend.dev can only send to your Resend account email.
MAIL_FROM=ET Trader <onboarding@resend.dev>
# Admin section access (comma-separated). The account must sign up and verify its email first.
ADMIN_EMAILS=connect@gmail.com
# Receives an email for every submitted payment, with a link to approve or reject it.
ADMIN_NOTIFY_EMAIL=connect@gmail.com
# Your USDT receiving wallet addresses. Leave a network empty to hide it at checkout.
USDT_TRC20_ADDRESS=
USDT_BEP20_ADDRESS=
USDT_ERC20_ADDRESS=
