{
  "name": "et-trader",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build -w @et-trader/shared",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "concurrently -n web,api -c magenta,cyan \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev -w @et-trader/frontend",
    "dev:backend": "npm run dev -w @et-trader/backend",
    "build": "npm run build -w @et-trader/shared && npm run build -w @et-trader/backend && npm run build -w @et-trader/frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint frontend backend packages",
    "test": "npm run test -w @et-trader/backend",
    "test:unit": "npm run test:unit -w @et-trader/backend",
    "test:e2e": "playwright test",
    "seed": "npm run seed -w @et-trader/backend"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
